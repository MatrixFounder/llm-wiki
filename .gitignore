# Framework symlink: installer's managed block only has `/.agentic-development/`
# (dir-only pattern), but on disk it's a symlink. Slashless form catches both.
/.agentic-development

# Wiki vault artifacts — this repo IS the implementation, NOT a vault.
# Belt-and-braces guard in case someone runs wiki-init with --vault pointing
# at the repo root (the CLI now requires explicit --vault, but defense in depth).
/WIKI_SCHEMA.md
/_sources/
/_concepts/
/_entities/
/_raw/
/00-Vault-Index/
*.db
*.db-shm
*.db-wal

# >>> agentic-development framework >>>
# Managed by the agentic-development installer. Do not edit between the markers.

# Framework content (symlink or local copy) and installer state.
/.agentic-development/
/.agentic-installer-state.json

# Framework components.
/.agent/skills/*
/.agent/workflows/*
/.agent/tools
/.agent/rules
/.agent/sessions
/System
/.claude/skills/*
/.claude/commands/*
/.claude/agents/*
/.claude/hooks
/.claude/settings.json
/.claude/settings.local.json
# pi (TASK 043): the generated skill symlinks are ignored like .claude/.agent; the committed
# subset is un-ignored below, and .pi/extensions/permissions.json (dev config) stays tracked.
/.pi/skills/*

# Claude bridge files (gitignored — they import the framework).
/CLAUDE.agentic.md
/CLAUDE.local.md

# .claude runtime locks.
/.claude/*.lock

