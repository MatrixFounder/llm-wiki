{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Bash(wiki-search *)",
      "Bash(wiki-query *)",
      "Bash(wiki-verify-multi *)",
      "Bash(wiki-sync *)",
      "Bash(wiki-reindex *)",
      "Bash(wiki-index-upsert *)",
      "Bash(wiki-index-render *)",
      "Bash(wiki-enrich *)",
      "Bash(wiki-extract-concepts *)",
      "Bash(wiki-append-log *)",
      "Bash(wiki-confirm *)",
      "Bash(wiki-alias *)",
      "Bash(wiki-merge *)",
      "Bash(wiki-lint *)",
      "Bash(wiki-init *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(jq *)",
      "Bash(python3 -m json.tool*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/*.key)"
    ]
  }
}
