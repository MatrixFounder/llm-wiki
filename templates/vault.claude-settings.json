{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Bash(wiki-search *)",
      "Bash(wiki-query *)",
      "Bash(wiki-verify-multi *)",
      "Bash(wiki-sync *)",
      "Bash(wiki-reindex *)",
      "Bash(wiki-index-upsert *)",
      "Bash(wiki-index-render *)",
      "Bash(wiki-enrich *)",
      "Bash(wiki-extract-concepts *)",
      "Bash(wiki-append-log *)",
      "Bash(wiki-confirm *)",
      "Bash(wiki-alias *)",
      "Bash(wiki-merge *)",
      "Bash(wiki-lint *)",
      "Bash(wiki-init *)",
      "Bash(obsidian help*)",
      "Bash(obsidian read *)",
      "Bash(obsidian search *)",
      "Bash(obsidian search:context *)",
      "Bash(obsidian backlinks *)",
      "Bash(obsidian links *)",
      "Bash(obsidian unresolved*)",
      "Bash(obsidian orphans*)",
      "Bash(obsidian deadends*)",
      "Bash(obsidian outline *)",
      "Bash(obsidian tags *)",
      "Bash(obsidian properties *)",
      "Bash(obsidian tasks *)",
      "Bash(obsidian vault *)",
      "Bash(obsidian vaults*)",
      "Bash(obsidian bases*)",
      "Bash(obsidian base:views*)",
      "Bash(obsidian base:query *)",
      "Bash(obsidian history *)",
      "Bash(touch *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(jq *)",
      "Bash(python3 -m json.tool*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(obsidian eval*)",
      "Bash(obsidian dev:*)",
      "Bash(obsidian devtools*)",
      "Bash(obsidian plugin:*)",
      "Bash(obsidian plugins:restrict*)",
      "Bash(obsidian sync on*)",
      "Bash(obsidian sync off*)",
      "Bash(obsidian restart*)",
      "Bash(obsidian reload*)",
      "Bash(obsidian theme:*)",
      "Bash(obsidian snippet:*)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/*.key)"
    ]
  }
}
